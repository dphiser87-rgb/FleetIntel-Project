{
  "expo": {
    "name": "FleetIntel",
    "slug": "fleetintel-mobile",
    "scheme": "fleetintel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fleetintel.mobile"
    },
    "android": {
      "package": "com.fleetintel.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "FleetIntel uses your photos to attach evidence to defects and inspections.",
          "cameraPermission": "FleetIntel uses your camera to capture defect and inspection photos."
        }
      ]
    ]
  }
}
